# Copy to .env.production.local only for an intentional production check.
# `npm run dev:production` also requires EHLLO_ALLOW_PRODUCTION=1.
# AFTERMEET_ALLOW_PRODUCTION remains accepted temporarily during migration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Do not commit or expose server-only credentials.
# SUPABASE_SERVICE_ROLE_KEY=

# Local dev runs API routes under Cloudflare workerd, which cannot load
# sharp. Deployed environments detect their own runtime and need no value.
EHLLO_SHARP=0
