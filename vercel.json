{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/cron/expire-recordings",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/send-follow-up-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/send-event-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-keep-in-touch-nudges",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/send-guest-followup-reminders",
      "schedule": "15 15 * * *"
    },
    {
      "path": "/api/cron/push-calendar-events",
      "schedule": "*/15 * * * *"
    }
  ]
}
