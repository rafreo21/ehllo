NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Unprefixed SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are also supported.
# Optional. When omitted, authentication uses the current browser origin.
NEXT_PUBLIC_APP_URL=
# Optional and server-only. Slice 1 does not require this key.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron: daily cleanup of shared recordings after 3-day cloud retention.
# CRON_SECRET=

# AI (transcription + extraction). Prefer a direct OpenAI key to skip AI Gateway billing:
# OPENAI_API_KEY=sk-...
# Optional model overrides (gateway-style openai/... ids also work):
# EHLLO_TRANSCRIPTION_MODEL=openai/whisper-1
# EHLLO_EXTRACTION_MODEL=openai/gpt-4.1
#
# Temporary test switch: route summaries/extraction/drafts to Claude instead of GPT-4.1.
# Claude has no audio input, so transcription (audio -> text) is a separate switch below.
# Remove EHLLO_TEXT_PROVIDER (or set it back to unset) to go back to GPT-4.1.
# ANTHROPIC_API_KEY=sk-ant-...
# EHLLO_TEXT_PROVIDER=claude
# EHLLO_CLAUDE_MODEL=claude-opus-5
#
# Temporary test switch: route transcription to Groq's free, OpenAI-compatible Whisper
# endpoint instead of OpenAI's - no billing account required. Get a key at console.groq.com.
# Remove EHLLO_TRANSCRIPTION_PROVIDER to go back to Whisper.
# GROQ_API_KEY=
# EHLLO_TRANSCRIPTION_PROVIDER=groq
# EHLLO_GROQ_MODEL=whisper-large-v3-turbo
# Legacy AFTERMEET_* AI variables remain accepted during migration.
#
# Alternative: Vercel AI Gateway (requires card / free credits unlocked):
# AI_GATEWAY_API_KEY=
# Or OIDC: `vercel link` + `vercel env pull` for VERCEL_OIDC_TOKEN (refreshed by `npm run predev`).

# Wallet passes (Phase 6). Required for signed Apple/Google Wallet output.
# APPLE_WALLET_PASS_TYPE_ID=pass.com.yourteam.ehllo
# APPLE_WALLET_TEAM_ID=YOUR_TEAM_ID
# APPLE_WALLET_WWDR_CERT=
# APPLE_WALLET_SIGNER_CERT=
# APPLE_WALLET_SIGNER_KEY=
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_WALLET_CLASS_SUFFIX=aftermeet_card

# Contact enrichment (LinkedIn import). Hunter.io email finder for verified work emails.
# HUNTER_API_KEY=

# CRM sync (Phase 7). HubSpot private app token with crm.objects.contacts + crm.objects.notes scopes.
# HUBSPOT_ACCESS_TOKEN=

# Connected accounts (Phase 8). Separate OAuth apps from Supabase sign-in.
# Redirect URIs:
#   {APP_URL}/api/integrations/google/callback
#   {APP_URL}/api/integrations/microsoft/callback
# GOOGLE_INTEGRATION_CLIENT_ID=
# GOOGLE_INTEGRATION_CLIENT_SECRET=
# MICROSOFT_INTEGRATION_CLIENT_ID=
# MICROSOFT_INTEGRATION_CLIENT_SECRET=

# Auth email setup (scripts/configure-supabase-auth.mjs) - never commit real values.
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ehllo <onboarding@resend.dev>
# SEND_EMAIL_HOOK_SECRET=
# Run once: npm run deploy:send-auth-email && npm run configure:supabase-auth

# OAuth setup script only (scripts/configure-oauth-providers.mjs)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# EHLLO_SITE_URL=https://ehllo.io
# Legacy AFTERMEET_SITE_URL remains accepted during migration.
