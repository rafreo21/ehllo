{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:staging",
    "dev:staging": "node scripts/run-web-dev.mjs staging",
    "dev:production": "node scripts/run-web-dev.mjs production",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "NITRO_PRESET=vercel vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern mobile",
    "db:generate": "drizzle-kit generate",
    "configure:supabase-auth": "node scripts/configure-supabase-auth.mjs",
    "deploy:send-auth-email": "node scripts/deploy-send-auth-email.mjs",
    "verify:resend-delivery": "node scripts/verify-resend-delivery.mjs",
    "verify:google-wallet": "node scripts/verify-google-wallet.mjs",
    "security:secrets": "node scripts/check-committed-secrets.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/openai": "^4.0.23",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/oidc": "^3.2.0",
    "ai": "^7.0.37",
    "drizzle-orm": "0.45.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "nitro": "^3.0.260610-beta",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.49.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.4",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true,
    "workerd@1.20260730.1": true,
    "esbuild@0.28.1": true
  }
}
