# Copy to .env.staging.local. Never put a production credential in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add server-only staging credentials only when a local server route needs them.
# SUPABASE_SERVICE_ROLE_KEY=

# Local dev runs API routes under Cloudflare workerd, which cannot load
# sharp. Deployed environments detect their own runtime and need no value.
EHLLO_SHARP=0
