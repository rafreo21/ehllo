{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging-simulator": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging-store": {
      "distribution": "store",
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {},
    "staging-store": {
      "ios": {
        "ascAppId": "6801942243",
        "appleTeamId": "VDR84B8UU2"
      },
      "android": {
        "serviceAccountKeyPath": "./aftermeet-503610-firebase-adminsdk-fbsvc-04a28f7167.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
