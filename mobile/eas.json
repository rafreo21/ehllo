{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging-simulator": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "staging-store": {
      "distribution": "store",
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {},
    "staging-store": {}
  }
}
